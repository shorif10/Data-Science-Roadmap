#!/usr/bin/env python3
"""
Data Science Roadmap - Notebook Generator
Generates 100+ professional Jupyter Notebooks for a complete Data Science curriculum.
"""

import json
import os

BASE_DIR = os.path.dirname(os.path.abspath(__file__))


def make_cell(source, cell_type="markdown", outputs=None, execution_count=None):
    """Create a notebook cell."""
    cell = {
        "cell_type": cell_type,
        "metadata": {},
        "source": source if isinstance(source, list) else [source],
    }
    if cell_type == "code":
        cell["execution_count"] = execution_count
        cell["outputs"] = outputs or []
    return cell


def make_notebook(cells, kernel="python3", display_name="Python 3"):
    """Create a complete notebook."""
    return {
        "nbformat": 4,
        "nbformat_minor": 5,
        "metadata": {
            "kernelspec": {
                "display_name": display_name,
                "language": "python",
                "name": kernel,
            },
            "language_info": {
                "name": "python",
                "version": "3.11.0",
                "mimetype": "text/x-python",
                "file_extension": ".py",
            },
        },
        "cells": cells,
    }


def save_notebook(notebook, path):
    """Save notebook to file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(notebook, f, indent=1, ensure_ascii=False)
    print(f"  Created: {os.path.relpath(path, BASE_DIR)}")


def nb(path, title, sections):
    """
    Quick helper: sections is a list of (header, body) or (header, body, "code", code).
    Returns a save path.
    """
    cells = [
        make_cell(f"# {title}\n\n---\n\n> **Module**: Data Science Roadmap\n> **Level**: Beginner → Advanced\n> **Objective**: Master {title.lower()}\n\n---"),
    ]
    for sec in sections:
        if len(sec) == 2:
            header, body = sec
            cells.append(make_cell(f"## {header}\n\n{body}"))
        else:
            header, body, ctype, code = sec
            cells.append(make_cell(f"## {header}\n\n{body}"))
            cells.append(make_cell(code, cell_type="code"))
    # Add interview questions and exercises
    cells.append(make_cell("## Key Interview Questions\n\n1. What are the key concepts covered in this notebook?\n2. How would you apply these concepts in a real-world scenario?\n3. What are the trade-offs between different approaches?\n4. Explain the time and space complexity of the main operations.\n5. What common mistakes should you avoid?\n\n## Practice Exercises\n\n1. Modify the code examples above to solve a different problem.\n2. Implement a function that uses all the concepts from this notebook.\n3. Find a real dataset and apply the techniques learned.\n4. Compare different approaches and document the trade-offs.\n5. Create a mini-project using at least 3 concepts from this notebook.\n\n## Mini Project\n\nBuild a small application that demonstrates your understanding of the concepts in this notebook. Focus on clean code, proper documentation, and testing.\n\n---\n\n**Next**: Continue to the next notebook in the module for more advanced topics."))
    notebook = make_notebook(cells)
    full_path = os.path.join(BASE_DIR, path)
    save_notebook(notebook, full_path)


# ============================================================
# MODULE 1: Python for Data Science
# ============================================================
print("=" * 60)
print("MODULE 1: Python for Data Science")
print("=" * 60)

