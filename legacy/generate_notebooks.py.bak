print("on same line")"""),

    ("Comments and Docstrings", """Good documentation is essential for maintainable code.""",
     "code", """# This is a single-line comment

"""
This is a docstring for the module.
It provides an overview of the module's purpose.
"""

def calculate_discount(price, discount_rate):
    """
    Calculate the discounted price.
    
    Args:
        price (float): Original price of the item.
        discount_rate (float): Discount rate between 0 and 1.
    
    Returns:
        float: The price after discount.
    
    Raises:
        ValueError: If discount_rate is not between 0 and 1.
    
    Example:
        >>> calculate_discount(100, 0.2)
        80.0
    """
    if not 0 <= discount_rate <= 1:
        raise ValueError("Discount rate must be between 0 and 1")
    return price * (1 - discount_rate)

# Help shows the docstring
help(calculate_discount)"""),
])

