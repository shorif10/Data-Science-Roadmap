nb("01_Python/04_Strings.ipynb", "Strings in Depth", [
    ("String Immutability", """Strings in Python are immutable — once created, they cannot be modified.""",
     "code", """s = "Hello"
# s[0] = "h"  # TypeError: 'str' object does not support item assignment

# Create new string instead
s = "h" + s[1:]
print(s)  # 'hello'

# String concatenation (inefficient in loops)
result = ""
for word in ["Data", "Science", "is", "fun"]:
    result += word + " "  # Creates new string each time

# Better: use join()
result = " ".join(["Data", "Science", "is", "fun"])
print(result)  # 'Data Science is fun'

# Strings support rich comparison
print("apple" < "banana")   # True (lexicographic)
print("abc" == "abc")       # True"""),

    ("Advanced String Methods", """Master the full string API.""",
     "code", """text = "  Hello, World!  "

# Stripping whitespace
print(text.strip())      # 'Hello, World!'
print(text.lstrip())     # 'Hello, World!  '
print(text.rstrip())     # '  Hello, World!'
print(text.strip(" !"))  # 'Hello, World'

# Searching
print(text.find("World"))      # 9
print(text.find("Python"))     # -1 (not found)
print(text.count("l"))         # 3
print(text.startswith("  H"))  # True
print(text.endswith("!  "))    # True

# Replacing
print(text.replace("World", "Python"))  # '  Hello, Python!  '
print(text.replace("l", "L", 2))        # '  HeLLo, World!  '

# Splitting and joining
csv_data = "name,age,city"
parts = csv_data.split(",")
print(parts)  # ['name', 'age', 'city']
print("-".join(parts))  # 'name-age-city'

# Encoding
text = "Hello, 世界"
encoded = text.encode("utf-8")
print(encoded)           # b'Hello, \xe4\xb8\x96\xe7\x95\x8c'
print(encoded.decode())  # 'Hello, 世界'

# Validation methods
print("123".isdigit())       # True
print("hello".isalpha())     # True
print("hello123".isalnum())  # True
print("  ".isspace())        # True
print("HELLO".isupper())     # True
print("hello".islower())     # True"""),

    ("String Slicing Mastery", """Advanced slicing techniques for data manipulation.""",
     "code", """s = "DataScience2024"

# Basic slicing: s[start:stop:step]
print(s[0:4])     # 'Data'
print(s[4:10])    # 'Science'
print(s[::2])     # 'DtScne24' (every 2nd char)
print(s[::-1])    # '4202ecneicSataD' (reversed)

# Negative indexing
print(s[-4:])     # '2024'
print(s[:-4])     # 'DataScience'
print(s[-6:-2])   # 'nce2'

# Advanced patterns
# Reverse words
sentence = "Hello World Python"
reversed_sentence = " ".join(sentence.split()[::-1])
print(reversed_sentence)  # 'Python World Hello'

# Extract domain from email
email = "user@domain.com"
domain = email.split("@")[1]
print(domain)  # 'domain.com'

# Check palindrome
def is_palindrome(s):
    s = s.lower().replace(" ", "")
    return s == s[::-1]

print(is_palindrome("racecar"))   # True
print(is_palindrome("hello"))     # False

# Caesar cipher (shift letters)
def caesar(text, shift):
    result = ""
    for char in text:
        if char.isalpha():
            base = ord('A') if char.isupper() else ord('a')
            result += chr((ord(char) - base + shift) % 26 + base)
        else:
            result += char
    return result

print(caesar("Hello World", 3))   # 'Khoor Zruog'
print(caesar("Khoor Zruog", -3))  # 'Hello World'"""),

    ("Regular Expressions with Strings", """Use regex for pattern matching in strings.""",
     "code", """import re

text = "Contact us at support@example.com or sales@company.org"

# Find all emails
emails = re.findall(r'[\w.]+@[\w.]+\.\w+', text)
print(emails)  # ['support@example.com', 'sales@company.org']

# Validate phone numbers
phone = "123-456-7890"
pattern = r'^\d{3}-\d{3}-\d{4}$'
print(bool(re.match(pattern, phone)))  # True

# Extract numbers from text
text = "I have 3 cats, 2 dogs, and 1 fish"
numbers = re.findall(r'\d+', text)
print(numbers)  # ['3', '2', '1']

# Replace patterns
text = "Hello   World    Python"
cleaned = re.sub(r'\s+', ' ', text)
print(cleaned)  # 'Hello World Python'

# Named groups
date = "2024-01-15"
match = re.match(r'(?P<year>\d{4})-(?P<month>\d{2})-(?P<day>\d{2})', date)
if match:
    print(f"Year: {match.group('year')}, Month: {match.group('month')}")

# Common regex patterns
patterns = {
    "Email": r'^[\w.]+@[\w.]+\.\w+$',
    "Phone": r'^\d{3}-\d{3}-\d{4}$',
    "URL": r'^https?://[\w.]+',
    "IPv4": r'^(\d{1,3}\.){3}\d{1,3}$',
    "Date": r'^\d{4}-\d{2}-\d{2}$',
}

for name, pattern in patterns.items():
    print(f"{name} pattern: {pattern}")"""),
])

nb("01_Python/05_Lists.ipynb", "Lists", [
    ("List Fundamentals", """Lists are ordered, mutable collections that can hold mixed types.""",
     "code", """# Creating lists
empty = []
numbers = [1, 2, 3, 4, 5]
