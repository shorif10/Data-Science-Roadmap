nb("03_Pandas/01_Pandas_Fundamentals.ipynb", "Pandas Fundamentals", [
    ("Introduction to Pandas", """Pandas is the most important library for data manipulation and analysis in Python.

**Key Features:**
- DataFrame and Series data structures
- Data alignment and integrated handling of missing data
- Powerful data grouping and aggregation
- Flexible reshaping and pivoting
- Time series functionality
- Easy file I/O (CSV, Excel, SQL, etc.)""",),
    ("Series", """One-dimensional labeled array.""",
     "code", """import pandas as pd
import numpy as np

# Create Series
s = pd.Series([1, 2, 3, 4, 5], index=['a', 'b', 'c', 'd', 'e'])
print(s)

# From dictionary
s_dict = pd.Series({'Alice': 90, 'Bob': 85, 'Charlie': 95})
print(s_dict)

# Access elements
print(s['a'])       # By label
print(s[0])         # By position
print(s['a':'c'])   # Slice by label
print(s.iloc[0:3])  # Slice by position

# Series operations
print(s + 10)           # Scalar operations
print(s * 2)            # Element-wise operations
print(s.sum(), s.mean(), s.std())

# Boolean indexing
print(s[s > 3])

# String operations
names = pd.Series(['alice', 'bob', 'charlie'])
print(names.str.title())
print(names.str.len())"""),

    ("DataFrames", """Two-dimensional labeled data structure.""",
     "code", """import pandas as pd
import numpy as np

# Create DataFrame from dict
data = {
    'Name': ['Alice', 'Bob', 'Charlie', 'David'],
    'Age': [25, 30, 35, 28],
    'City': ['NYC', 'LA', 'Chicago', 'Boston'],
    'Salary': [75000, 85000, 95000, 80000]
}
df = pd.DataFrame(data)
print(df)

# Basic inspection
print(f"Shape: {df.shape}")
print(f"Columns: {df.columns.tolist()}")
print(f"Data types:\\n{df.dtypes}")
print(df.head(2))     # First 2 rows
print(df.tail(2))     # Last 2 rows
print(df.info())      # Summary
print(df.describe())  # Statistics

# Selection
print(df['Name'])        # Column
print(df[['Name', 'Age']])  # Multiple columns
print(df.iloc[0])        # First row
print(df.loc[0:2])       # Rows 0-2

# Adding columns
df['Bonus'] = df['Salary'] * 0.1
df['Total'] = df['Salary'] + df['Bonus']

# Dropping
df_dropped = df.drop(columns=['Bonus'])"""),

