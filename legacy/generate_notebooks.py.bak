    elif path.is_dir():
        print(f"Dir:  {path.relative_to(project)}/")

# Find Python files
py_files = list(project.rglob("*.py"))
print(f"Python files: {py_files}")

# Working directory
import os
cwd = Path.cwd()
print(f"Current: {cwd}")
print(f"Home: {Path.home()}")

# Cleanup
import shutil
shutil.rmtree(project)"""),
