nb("17_MLOps/01_MLOps_Fundamentals.ipynb", "MLOps Fundamentals", [
    ("What is MLOps?", """MLOps (Machine Learning Operations) is a set of practices that combines Machine Learning, DevOps, and Data Engineering to deploy and maintain ML systems in production reliably and efficiently.

**Key Components:**
1. **Version Control**: Code, data, and models
2. **Experiment Tracking**: Log parameters, metrics, artifacts
3. **Model Registry**: Store and version models
4. **Pipeline Orchestration**: Automate ML workflows
5. **Model Serving**: Deploy models for inference
6. **Monitoring**: Track model performance in production
7. **CI/CD**: Continuous integration and deployment

**Why MLOps?**
- Reproducibility
- Scalability
- Reliability
- Faster iteration
- Collaboration""",),
    ("Experiment Tracking with MLflow", """Track experiments, parameters, and metrics.""",
     "code", """# MLflow example
# pip install mlflow scikit-learn

import mlflow
import mlflow.sklearn
from sklearn.ensemble import RandomForestClassifier
from sklearn.datasets import load_iris
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

# Load data
iris = load_iris()
X_train, X_test, y_train, y_test = train_test_split(
    iris.data, iris.target, test_size=0.2, random_state=42
)

# Start MLflow run
mlflow.set_experiment("iris_classification")

with mlflow.start_run(run_name="random_forest_v1"):
    # Parameters
    n_estimators = 100
    max_depth = 5
    
    # Train model
    model = RandomForestClassifier(n_estimators=n_estimators, max_depth=max_depth)
    model.fit(X_train, y_train)
    
    # Predictions
    y_pred = model.predict(X_test)
    accuracy = accuracy_score(y_test, y_pred)
    
    # Log parameters
    mlflow.log_param("n_estimators", n_estimators)
    mlflow.log_param("max_depth", max_depth)
    
    # Log metrics
    mlflow.log_metric("accuracy", accuracy)
    
    # Log model
    mlflow.sklearn.log_model(model, "model")
    
    # Log artifacts
    # mlflow.log_artifact("confusion_matrix.png")
    
    print(f"Accuracy: {accuracy:.4f}")
    print(f"Run ID: {mlflow.active_run().info.run_id}")

# View results
# mlflow ui  # Opens web interface at http://localhost:5000"""),

    ("DVC (Data Version Control)", """Version control for data and models.""",
     "code", """# DVC commands (run in terminal)
# pip install dvc

# Initialize DVC
# dvc init
# git add .dvc .dvcignore
# git commit -m "Initialize DVC"

# Track data files
# dvc add data/train.csv
# git add data/train.csv.dvc
# git commit -m "Add training data"

# Remote storage
# dvc remote add -d myremote s3://mybucket/dvc
# dvc push
# dvc pull

# Experiments
# dvc exp run
# dvc exp show
# dvc exp diff

# Pipeline
# dvc.yaml defines the pipeline:
# stages:
#   prepare:
#     cmd: python src/data/prepare.py
#     deps:
#       - src/data/prepare.py
#       - data/raw
#     outs:
#       - data/prepared
#   train:
#     cmd: python src/models/train.py
#     deps:
#       - src/models/train.py
#       - data/prepared
#     params:
#       - model.n_estimators
#       - model.max_depth
#     outs:
#       - models/model.pkl
#     metrics:
#       - metrics.json:
#           cache: false

# Run pipeline
# dvc repro

# Compare experiments
# dvc metrics diff"""),

    ("Docker for ML", """Containerize ML applications.""",
     "code", """# Dockerfile for ML model
dockerfile = \"\"\"
# Use Python base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application
COPY src/ ./src/
COPY models/ ./models/

# Expose port
EXPOSE 8000

# Run application
CMD [\"python\", \"src/api.py\"]
\"\"\"

# docker-compose.yml
docker_compose = \"\"\"
version: '3.8'

services:
  api:
    build: .
    ports:
      - \"8000:8000\"
    volumes:
      - ./models:/app/models
    environment:
      - MODEL_PATH=/app/models/model.pkl
    depends_on:
      - redis
      - postgres
  
  redis:
    image: redis:alpine
    ports:
      - \"6379:6379\"
  
  postgres:
    image: postgres:15
    environment:
      POSTGRES_DB: mlops
      POSTGRES_PASSWORD: password
    volumes:
      - postgres_data:/var/lib/postgresql/data

volumes:
  postgres_data:
\"\"\"

print("Docker Commands:")
print("docker build -t ml-api .")
print("docker run -p 8000:8000 ml-api")
print("docker-compose up -d")
print("docker-compose down")"""),

    ("FastAPI Model Serving", """Deploy ML models as REST APIs.""",
     "code", """# api.py
from fastapi import FastAPI
from pydantic import BaseModel
import numpy as np
import pickle

app = FastAPI(title="ML Model API")

# Load model
with open("models/model.pkl", "rb") as f:
    model = pickle.load(f)

# Request schema
class PredictionRequest(BaseModel):
    features: list[float]

class PredictionResponse(BaseModel):
    prediction: int
    probability: float

@app.get("/health")
def health_check():
    return {"status": "healthy"}

@app.post("/predict", response_model=PredictionResponse)
def predict(request: PredictionRequest):
    features = np.array(request.features).reshape(1, -1)
    prediction = model.predict(features)[0]
    probability = model.predict_proba(features).max()
    return PredictionResponse(prediction=int(prediction), probability=float(probability))

@app.get("/model/info")
def model_info():
    return {
        "model_type": type(model).__name__,
        "features": model.n_features_in_,
        "classes": model.classes_.tolist()
    }

# Run with: uvicorn api:app --host 0.0.0.0 --port 8000
# API docs: http://localhost:8000/docs"""),

    ("CI/CD for ML", """Automate testing and deployment.""",
     "code", """# GitHub Actions workflow
github_actions = \"\"\"
name: ML Pipeline

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'
      
      - name: Install dependencies
        run: |
          pip install -r requirements.txt
          pip install pytest
      
      - name: Run tests
        run: pytest tests/ -v
      
      - name: Run linting
        run: |
          pip install ruff
          ruff check src/
  
  train:
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      
      - name: Train model
        run: python src/models/train.py
      
      - name: Upload model artifact
        uses: actions/upload-artifact@v3
        with:
          name: model
          path: models/
  
  deploy:
    needs: train
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    steps:
      - name: Deploy to production
        run: |
          docker build -t ml-api .
          docker push registry/ml-api:latest
\"\"\"

# Jenkins pipeline
jenkins_pipeline = \"\"\"
pipeline {
    agent any
    
    stages {
        stage('Test') {
            steps {
                sh 'pytest tests/ -v'
            }
        }
        stage('Train') {
            steps {
                sh 'python src/models/train.py'
            }
        }
        stage('Build') {
            steps {
                sh 'docker build -t ml-api .'
            }
        }
        stage('Deploy') {
            steps {
                sh 'docker push registry/ml-api:latest'
                sh 'kubectl apply -f k8s/'
            }
        }
    }
}
\"\"\"

print("CI/CD Best Practices for ML:")
print("1. Test data quality before training")
print("2. Validate model performance before deployment")
print("3. Use model registry for versioning")
print("4. Implement canary deployments")
print("5. Monitor model performance post-deployment")"""),

    ("Model Monitoring", """Track model performance in production.""",
     "code", """# Evidently AI for monitoring
# pip install evidently

from evidently import ColumnMapping
from evidently.report import Report
from evidently.metric_preset import DataDriftPreset, TargetDriftPreset
import pandas as pd
import numpy as np

# Reference data (training)
reference_data = pd.DataFrame({
    'feature1': np.random.randn(1000),
    'feature2': np.random.randn(1000),
    'target': np.random.choice([0, 1], 1000)
})

# Current data (production)
current_data = pd.DataFrame({
    'feature1': np.random.randn(1000) + 0.5,  # Drift!
    'feature2': np.random.randn(1000),
    'target': np.random.choice([0, 1], 1000)
})

# Create report
report = Report(metrics=[
    DataDriftPreset(),
    TargetDriftPreset()
])

report.run(reference_data=reference_data, current_data=current_data)
report.save_html("monitoring_report.html")

# Prometheus metrics
prometheus_config = \"\"\"
# Custom metrics for ML monitoring
model_predictions_total{model=\"v1\"} 1000
model_accuracy{model=\"v1\"} 0.95
model_latency_seconds{quantile=\"0.99\"} 0.1
data_drift_score{feature=\"feature1\"} 0.3
\"\"\"

print("Monitoring Checklist:")
print("1. Data drift detection")
print("2. Model performance metrics")
print("3. Prediction latency")
print("4. Error rates")
print("5. Feature distribution changes")
print("6. Concept drift detection")"""),

    ("Kubernetes for ML", """Deploy and scale ML services.""",
     "code", """# Kubernetes deployment for ML model
k8s_deployment = \"\"\"
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ml-api
spec:
  replicas: 3
  selector:
    matchLabels:
      app: ml-api
  template:
    metadata:
      labels:
        app: ml-api
    spec:
      containers:
      - name: ml-api
        image: registry/ml-api:latest
        ports:
        - containerPort: 8000
        resources:
          requests:
            memory: \"512Mi\"
            cpu: \"250m\"
          limits:
            memory: \"1Gi\"
            cpu: \"500m\"
        env:
        - name: MODEL_PATH
          value: \"/app/models/model.pkl\"
---
apiVersion: v1
kind: Service
metadata:
  name: ml-api-service
spec:
  selector:
    app: ml-api
  ports:
  - port: 80
    targetPort: 8000
  type: LoadBalancer
\"\"\"

# GPU support
gpu_config = \"\"\"
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ml-api-gpu
spec:
  replicas: 1
  template:
    spec:
      containers:
      - name: ml-api
        image: registry/ml-api-gpu:latest
        resources:
          limits:
            nvidia.com/gpu: 1
\"\"\"

