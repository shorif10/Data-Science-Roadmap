    ("Distribution Plots", """Visualize data distributions.""",
     "code", """import seaborn as sns
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd

# Set style
sns.set_style("whitegrid")

# Create sample data
np.random.seed(42)
data = pd.DataFrame({
    'value': np.concatenate([np.random.normal(0, 1, 1000), np.random.normal(3, 1, 1000)]),
    'category': ['A'] * 1000 + ['B'] * 1000
})

# Histogram
fig, axes = plt.subplots(2, 2, figsize=(12, 10))

# Basic histogram
sns.histplot(data=data, x='value', kde=True, ax=axes[0, 0])
axes[0, 0].set_title('Histogram with KDE')

# Stacked histogram
sns.histplot(data=data, x='value', hue='category', multiple='stack', ax=axes[0, 1])
axes[0, 1].set_title('Stacked Histogram')

# KDE plot
sns.kdeplot(data=data, x='value', hue='category', fill=True, ax=axes[1, 0])
axes[1, 0].set_title('KDE Plot')

# ECDF plot
sns.ecdfplot(data=data, x='value', hue='category', ax=axes[1, 1])
axes[1, 1].set_title('ECDF Plot')

plt.tight_layout()
plt.show()"""),

