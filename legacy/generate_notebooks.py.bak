    ("Basic Plots", """Create common chart types.""",
     "code", """import matplotlib.pyplot as plt
import numpy as np

# Line plot
x = np.linspace(0, 10, 100)
y = np.sin(x)

plt.figure(figsize=(10, 6))
plt.plot(x, y, label='sin(x)', color='blue', linewidth=2)
plt.plot(x, np.cos(x), label='cos(x)', color='red', linestyle='--')
plt.xlabel('X')
plt.ylabel('Y')
plt.title('Trigonometric Functions')
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

# Scatter plot
np.random.seed(42)
x = np.random.randn(100)
y = np.random.randn(100)
colors = np.random.rand(100)
sizes = np.random.rand(100) * 100

plt.figure(figsize=(8, 6))
plt.scatter(x, y, c=colors, s=sizes, alpha=0.6, cmap='viridis')
plt.colorbar(label='Color value')
plt.xlabel('X')
plt.ylabel('Y')
plt.title('Scatter Plot')
plt.show()

# Bar chart
categories = ['A', 'B', 'C', 'D', 'E']
values = [23, 45, 56, 78, 32]

plt.figure(figsize=(8, 5))
plt.bar(categories, values, color=['#FF6B6B', '#4ECDC4', '#45B7D1', '#96CEB4', '#FFEAA7'])
plt.xlabel('Category')
plt.ylabel('Value')
plt.title('Bar Chart')
plt.show()"""),

    ("Subplots", """Multiple plots in one figure.""",
     "code", """import matplotlib.pyplot as plt
import numpy as np

# Method 1: plt.subplots()
fig, axes = plt.subplots(2, 2, figsize=(12, 8))

x = np.linspace(0, 10, 100)

# Plot 1: Line
axes[0, 0].plot(x, np.sin(x), color='blue')
axes[0, 0].set_title('Sine Wave')

# Plot 2: Scatter
axes[0, 1].scatter(np.random.randn(50), np.random.randn(50), c='red', alpha=0.6)
axes[0, 1].set_title('Scatter Plot')

# Plot 3: Histogram
axes[1, 0].hist(np.random.randn(1000), bins=30, color='green', alpha=0.7)
axes[1, 0].set_title('Histogram')

# Plot 4: Bar
axes[1, 1].bar(['A', 'B', 'C', 'D'], [23, 45, 56, 78], color='orange')
axes[1, 1].set_title('Bar Chart')

plt.tight_layout()
plt.show()

# Method 2: GridSpec for complex layouts
fig = plt.figure(figsize=(12, 8))
gs = fig.add_gridspec(3, 3)

ax1 = fig.add_subplot(gs[0, :])    # Top row (all columns)
ax2 = fig.add_subplot(gs[1, :2])   # Middle row (first 2 cols)
ax3 = fig.add_subplot(gs[1, 2])    # Middle row (last col)
ax4 = fig.add_subplot(gs[2, :])    # Bottom row (all columns)

ax1.set_title('Full Width Top')
ax2.set_title('Two Thirds')
ax3.set_title('One Third')
ax4.set_title('Full Width Bottom')

plt.tight_layout()
plt.show()"""),

    ("Styling and Customization", """Make your plots publication-ready.""",
     "code", """import matplotlib.pyplot as plt
import numpy as np

# Use style sheets
plt.style.use('seaborn-v0_8-darkgrid')  # or 'ggplot', 'bmh', 'fivethirtyeight'

# Custom figure properties
plt.rcParams.update({
    'font.size': 12,
    'axes.titlesize': 14,
    'axes.labelsize': 12,
    'figure.dpi': 100
})

x = np.linspace(0, 10, 100)

# Create styled plot
fig, ax = plt.subplots(figsize=(10, 6))

# Multiple lines with styling
ax.plot(x, np.sin(x), 
        color='#2196F3', 
        linewidth=2, 
        linestyle='-', 
        marker='o', 
        markevery=10,
        label='sin(x)')

ax.plot(x, np.cos(x),
        color='#F44336',
        linewidth=2,
        linestyle='--',
        marker='s',
        markevery=10,
        label='cos(x)')

# Fill between
ax.fill_between(x, np.sin(x), alpha=0.2, color='#2196F3')

# Annotations
ax.annotate('Peak', 
            xy=(np.pi/2, 1), 
            xytext=(np.pi/2 + 1, 0.8),
            arrowprops=dict(arrowstyle='->', color='black'),
            fontsize=12)

# Limits and labels
ax.set_xlim(0, 10)
ax.set_ylim(-1.5, 1.5)
ax.set_xlabel('X-axis')
ax.set_ylabel('Y-axis')
ax.set_title('Styled Plot with Annotations')
ax.legend(loc='upper right')
ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('styled_plot.png', dpi=300, bbox_inches='tight')
plt.show()"""),

    ("Advanced Visualization Techniques", """Professional plotting patterns.""",
     "code", """import matplotlib.pyplot as plt
