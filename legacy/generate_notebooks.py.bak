    ("Data Cleaning", """Handle missing values, duplicates, and data quality issues.""",
     "code", """import pandas as pd
import numpy as np

# Create sample data with issues
df = pd.DataFrame({
    'Name': ['Alice', 'Bob', None, 'David', 'Alice'],
    'Age': [25, np.nan, 35, 28, 25],
    'Email': ['a@test.com', 'b@test.com', 'c@test.com', None, 'a@test.com'],
    'Salary': [75000, 85000, 95000, 80000, 75000]
})

print("Original:")
print(df)

# Check missing values
print(f"\\nMissing values:\\n{df.isnull().sum()}")

# Drop missing
df_clean = df.dropna()
print(f"\\nAfter dropna: {len(df_clean)} rows")

# Fill missing
df_filled = df.fillna({
    'Name': 'Unknown',
    'Age': df['Age'].mean(),
    'Email': 'no-email@test.com'
})
print(f"\\nAfter fillna:\\n{df_filled}")

# Duplicates
print(f"\\nDuplicates: {df.duplicated().sum()}")
df_unique = df.drop_duplicates()
print(f"After dedup: {len(df_unique)} rows")

# Data type conversion
df['Age'] = df['Age'].astype(float)

# String cleaning
df['Name'] = df['Name'].str.strip().str.lower()

# Outlier detection (IQR method)
Q1 = df['Salary'].quantile(0.25)
Q3 = df['Salary'].quantile(0.75)
IQR = Q3 - Q1
outliers = df[(df['Salary'] < Q1 - 1.5*IQR) | (df['Salary'] > Q3 + 1.5*IQR)]
print(f"\\nOutliers: {len(outliers)}")"""),

    ("Data Transformation", """Apply transformations to data.""",
     "code", """import pandas as pd
import numpy as np

df = pd.DataFrame({
    'Name': ['Alice', 'Bob', 'Charlie', 'David'],
    'Age': [25, 30, 35, 28],
    'Salary': [75000, 85000, 95000, 80000],
    'Department': ['Engineering', 'Marketing', 'Engineering', 'Sales']
})

# Apply function
df['Age_Group'] = df['Age'].apply(lambda x: 'Young' if x < 30 else 'Senior')

# Map
dept_map = {'Engineering': 'Tech', 'Marketing': 'Business', 'Sales': 'Business'}
df['Division'] = df['Department'].map(dept_map)

# Assign
df = df.assign(
    Tax=df['Salary'] * 0.3,
    Net=df['Salary'] * 0.7
)

# Rename columns
df = df.rename(columns={'Name': 'Employee'})

# Sort
df_sorted = df.sort_values('Salary', ascending=False)

# Replace
df['Age_Group'] = df['Age_Group'].replace({'Young': 'Junior', 'Senior': 'Senior'})

print(df_sorted)"""),

    ("GroupBy Operations", """Aggregate and analyze grouped data.""",
     "code", """import pandas as pd
import numpy as np

df = pd.DataFrame({
    'Department': ['Eng', 'Eng', 'Mkt', 'Mkt', 'Sales', 'Sales'],
    'Employee': ['A', 'B', 'C', 'D', 'E', 'F'],
    'Salary': [100, 120, 90, 95, 80, 85],
    'Performance': [4.5, 4.0, 3.5, 4.2, 3.8, 4.0]
})

# Basic groupby
grouped = df.groupby('Department')
print(grouped.mean(numeric_only=True))

# Multiple aggregations
print(df.groupby('Department').agg({
    'Salary': ['mean', 'max', 'min'],
    'Performance': 'mean'
}))

# Custom aggregation
def salary_range(x):
    return x.max() - x.min()

print(df.groupby('Department').agg({
    'Salary': ['mean', salary_range]
}))

# Transform (returns same-sized result)
df['Dept_Avg_Salary'] = df.groupby('Department')['Salary'].transform('mean')
df['Salary_vs_Avg'] = df['Salary'] - df['Dept_Avg_Salary']

# Filter groups
high_performers = df.groupby('Department').filter(lambda x: x['Performance'].mean() > 3.8)
print(f"\\nHigh-performing departments:\\n{high_performers}")

# Get group
eng_team = df.groupby('Department').get_group('Eng')
print(f"\\nEngineering team:\\n{eng_team}")"""),

    ("Merge and Join", """Combine DataFrames.""",
     "code", """import pandas as pd

# Create sample DataFrames
employees = pd.DataFrame({
    'emp_id': [1, 2, 3, 4],
    'name': ['Alice', 'Bob', 'Charlie', 'David'],
    'dept_id': [101, 102, 101, 103]
})

departments = pd.DataFrame({
    'dept_id': [101, 102, 104],
    'dept_name': ['Engineering', 'Marketing', 'Finance']
})

# Inner join (only matching)
inner = pd.merge(employees, departments, on='dept_id', how='inner')
print("Inner Join:")
print(inner)

# Left join (all from left)
left = pd.merge(employees, departments, on='dept_id', how='left')
print("\\nLeft Join:")
print(left)

# Right join (all from right)
right = pd.merge(employees, departments, on='dept_id', how='right')
print("\\nRight Join:")
print(right)

# Outer join (all from both)
outer = pd.merge(employees, departments, on='dept_id', how='outer')
print("\\nOuter Join:")
print(outer)

# Concatenate
df1 = pd.DataFrame({'A': [1, 2], 'B': [3, 4]})
df2 = pd.DataFrame({'A': [5, 6], 'B': [7, 8]})
concatenated = pd.concat([df1, df2], ignore_index=True)
print("\\nConcatenated:")
print(concatenated)"""),

    ("Pivot Tables and Cross-tabulation", """Reshape data.""",
     "code", """import pandas as pd
import numpy as np

# Sample sales data
df = pd.DataFrame({
    'Date': pd.date_range('2024-01-01', periods=12),
    'Region': np.random.choice(['North', 'South', 'East', 'West'], 12),
    'Product': np.random.choice(['A', 'B'], 12),
    'Sales': np.random.randint(100, 1000, 12)
})

# Pivot table
pivot = df.pivot_table(
    values='Sales',
    index='Region',
    columns='Product',
    aggfunc='sum',
    fill_value=0
)
print("Pivot Table:")
print(pivot)

# Cross-tabulation
ct = pd.crosstab(df['Region'], df['Product'], margins=True)
print("\\nCross-tabulation:")
print(ct)

# Multi-level index
pivot_multi = df.pivot_table(
    values='Sales',
    index=['Region'],
    columns=['Product'],
    aggfunc=['sum', 'mean']
)
print("\\nPivot with multiple aggfunc:")
print(pivot_multi)"""),

    ("Time Series", """Work with time-based data.""",
     "code", """import pandas as pd
import numpy as np

# Create time series
dates = pd.date_range('2024-01-01', periods=365, freq='D')
ts = pd.Series(np.random.randn(365).cumsum(), index=dates)

# Access datetime components
print(f"Year: {ts.index.year[:5].tolist()}")
print(f"Month: {ts.index.month[:5].tolist()}")
print(f"Day of week: {ts.index.dayofweek[:5].tolist()}")

# Resampling
daily = ts.resample('D').mean()
weekly = ts.resample('W').mean()
monthly = ts.resample('M').mean()

# Rolling windows
rolling_mean = ts.rolling(window=30).mean()
expanding_mean = ts.expanding().mean()

# Time zones
ts_utc = ts.tz_localize('UTC')
ts_ny = ts_utc.tz_convert('America/New_York')

# Date offsets
business_days = pd.date_range('2024-01-01', periods=10, freq='B')
print(f"\\nBusiness days: {business_days.tolist()}")

# Period indexing
periods = pd.period_range('2024-01', periods=12, freq='M')
print(f"\\nMonthly periods: {periods}"""),

    ("Performance Optimization", """Make Pandas operations faster.""",
     "code", """import pandas as pd
import numpy as np
import time

# Use appropriate dtypes
df = pd.DataFrame({
    'id': np.random.randint(0, 100, 100000),
    'value': np.random.randn(100000),
    'category': np.random.choice(['A', 'B', 'C'], 100000)
})

# Optimize dtypes
df['id'] = df['id'].astype('int32')  # int64 -> int32
df['category'] = df['category'].astype('category')  # object -> category

print(f"Memory usage: {df.memory_usage(deep=True).sum() / 1024:.1f} KB")

# Vectorized operations (avoid loops!)
# BAD
start = time.time()
result = [x * 2 for x in df['value']]
print(f"Loop: {time.time() - start:.4f}s")

# GOOD
start = time.time()
result = df['value'] * 2
print(f"Vectorized: {time.time() - start:.4f}s")

# Use eval() for large operations
df['computed'] = df.eval('value * 2 + id')

# Use query() for filtering
filtered = df.query('value > 0 and category == "A"')

# Chunk processing for large files
# chunks = pd.read_csv('large.csv', chunksize=10000)
# for chunk in chunks:
#     process(chunk)

# Use PyArrow backend (Pandas 2.0+)
# df = pd.read_csv('data.csv', dtype_backend='pyarrow')"""),
])

nb("03_Pandas/02_Advanced_Pandas.ipynb", "Advanced Pandas Techniques", [
    ("MultiIndex", """Work with hierarchical indexing.""",
     "code", """import pandas as pd
import numpy as np

# Create MultiIndex DataFrame
arrays = [
    ['NY', 'NY', 'CA', 'CA', 'TX', 'TX'],
    ['NYC', 'Buffalo', 'LA', 'SF', 'Houston', 'Dallas']
]
index = pd.MultiIndex.from_arrays(arrays, names=['State', 'City'])
df = pd.DataFrame({
    'Population': [8.3, 0.28, 3.9, 0.88, 2.3, 1.3],
    'GDP': [1.7, 0.05, 0.9, 0.45, 0.5, 0.2]
}, index=index)
print(df)

# Access levels
print("\\nNYC:", df.loc[('NY', 'NYC')])
print("\\nAll NY:", df.loc['NY'])

# Swap levels
df_swapped = df.swaplevel()
print("\\nSwapped:", df_swapped)

# Stack/Unstack
unstacked = df.unstack()
print("\\nUnstacked:", unstacked)

# Cross-section
print("\\nCross-section:", df.xs('NY', level='State'))"""),

    ("Method Chaining", """Write fluent, readable Pandas code.""",
     "code", """import pandas as pd
import numpy as np

# Method chaining example
df = pd.DataFrame({
    'name': ['Alice', 'Bob', 'Charlie', 'David', 'Eve'],
    'age': [25, 30, 35, 28, 22],
    'salary': [75000, 85000, 95000, 80000, 70000],
    'dept': ['Eng', 'Mkt', 'Eng', 'Sales', 'Eng']
})

# Chained operations
result = (
    df
    .query('age > 25')
    .assign(tax=lambda x: x['salary'] * 0.3)
    .assign(net=lambda x: x['salary'] - x['tax'])
    .groupby('dept')
    .agg({'salary': 'mean', 'net': 'sum'})
    .sort_values('salary', ascending=False)
)
print(result)

# Using pipe for custom functions
def add_ranking(df, column):
    df[f'{column}_rank'] = df[column].rank(ascending=False)
    return df

def filter_by_quantile(df, column, quantile):
    threshold = df[column].quantile(quantile)
    return df[df[column] >= threshold]

result = (
    df
    .pipe(add_ranking, 'salary')
    .pipe(filter_by_quantile, 'salary', 0.5)
)
print("\\nWith ranking:", result)"""),

    ("Window Functions", """Rolling, expanding, and ewm operations.""",
     "code", """import pandas as pd
import numpy as np

# Time series data
dates = pd.date_range('2024-01-01', periods=30, freq='D')
df = pd.DataFrame({
    'date': dates,
    'sales': np.random.randint(100, 500, 30).cumsum(),
    'visits': np.random.randint(50, 200, 30)
})

# Rolling window
df['rolling_mean'] = df['sales'].rolling(window=7).mean()
df['rolling_std'] = df['sales'].rolling(window=7).std()
df['rolling_min'] = df['sales'].rolling(window=7).min()
df['rolling_max'] = df['sales'].rolling(window=7).max()

# Expanding (cumulative)
df['expanding_mean'] = df['sales'].expanding().mean()
df['cumsum'] = df['sales'].cumsum()

# Exponential weighted moving average
df['ewm'] = df['sales'].ewm(span=7).mean()

# Custom window function
df['pct_change'] = df['sales'].pct_change()
df['lag_1'] = df['sales'].shift(1)
df['lead_1'] = df['sales'].shift(-1)

print(df[['date', 'sales', 'rolling_mean', 'ewm']].head(10)"""),

    ("String Operations", """Vectorized string operations.""",
     "code", """import pandas as pd

# String Series
names = pd.Series(['alice', 'BOB', '  charlie  ', 'david123', 'eve@email.com'])

# Basic operations
print(names.str.lower())
print(names.str.upper())
print(names.str.strip())
print(names.str.title())

# String methods
print(names.str.contains('dav'))
print(names.str.startswith('a'))
print(names.str.endswith('.com'))
print(names.str.len())

# Extract patterns
print(names.str.extract(r'(\\d+)'))  # Extract numbers
print(names.str.split('@'))          # Split

# Replace
print(names.str.replace(r'\\d+', '', regex=True))  # Remove numbers

# Padding and formatting
print(names.str.pad(20, fillchar='-'))
print(names.str.center(20, '*'))

# Multi-column string operations
df = pd.DataFrame({
    'first': ['Alice', 'Bob', 'Charlie'],
    'last': ['Smith', 'Jones', 'Brown']
})

df['full_name'] = df['first'] + ' ' + df['last']
df['initials'] = df['first'].str[0] + df['last'].str[0]
print(df)"""),

    ("Merge Strategies and Techniques", """Advanced merging patterns.""",
     "code", """import pandas as pd
import numpy as np

# Multiple merge keys
left = pd.DataFrame({
    'key1': ['A', 'A', 'B'],
    'key2': ['X', 'Y', 'X'],
    'value': [1, 2, 3]
})

right = pd.DataFrame({
    'key1': ['A', 'B', 'B'],
    'key2': ['X', 'X', 'Y'],
    'value': [4, 5, 6]
})

# Merge on multiple keys
merged = pd.merge(left, right, on=['key1', 'key2'], suffixes=('_left', '_right'))
print(merged)

# Cross join
df1 = pd.DataFrame({'A': [1, 2]})
df2 = pd.DataFrame({'B': ['x', 'y', 'z']})
cross = pd.merge(df1, df2, how='cross')
print("\\nCross join:")
print(cross)

# Validate merge
# pd.merge(left, right, on='key', validate='one_to_one')
# pd.merge(left, right, on='key', validate='one_to_many')

# Indicator column
merged = pd.merge(left, right, on=['key1', 'key2'], indicator=True)
print("\\nMerge indicator:")
print(merged)

# Semi join (only matching rows from left)
semi = left[left['key1'].isin(right['key1'])]

# Anti join (only non-matching rows from left)
anti = left[~left['key1'].isin(right['key1'])]"""),

    ("Memory Optimization", """Reduce DataFrame memory usage.""",
     "code", """import pandas as pd
import numpy as np

# Sample DataFrame
n = 100000
df = pd.DataFrame({
    'int_large': np.random.randint(0, 100, n),
    'float_large': np.random.randn(n) * 1000,
    'str_col': np.random.choice(['A', 'B', 'C', 'D'], n),
    'bool_col': np.random.choice([True, False], n)
})

# Check memory usage
print("Before optimization:")
print(df.memory_usage(deep=True).sum() / 1024 / 1024, "MB")

# Optimize integers
df['int_large'] = pd.to_numeric(df['int_large'], downcast='integer')

# Optimize floats
df['float_large'] = pd.to_numeric(df['float_large'], downcast='float')

# Optimize strings to category
df['str_col'] = df['str_col'].astype('category')

# Optimize booleans
df['bool_col'] = df['bool_col'].astype('bool')

print("\\nAfter optimization:")
print(df.memory_usage(deep=True).sum() / 1024 / 1024, "MB")

# Using pyarrow backend (Pandas 2.0+)
# df = pd.read_csv('data.csv', dtype_backend='pyarrow')
# This can reduce memory by 50-70%!"""),

    ("Apply, Map, and Vectorized Operations", """Choose the right approach.""",
     "code", """import pandas as pd
import numpy as np
import time

df = pd.DataFrame({
    'A': np.random.randn(100000),
    'B': np.random.randn(100000)
})

# Vectorized (fastest)
start = time.time()
df['C'] = df['A'] + df['B']
print(f"Vectorized: {time.time() - start:.4f}s")

# Apply with lambda (slower)
start = time.time()
df['C'] = df.apply(lambda row: row['A'] + row['B'], axis=1)
print(f"Apply (row): {time.time() - start:.4f}s")

# Apply with function (faster than lambda)
def add_cols(row):
    return row['A'] + row['B']

start = time.time()
df['C'] = df.apply(add_cols, axis=1)
print(f"Apply (func): {time.time() - start:.4f}s")

# np.where (good for conditionals)
df['D'] = np.where(df['A'] > 0, 'positive', 'negative')

# np.select (multiple conditions)
conditions = [df['A'] > 1, df['A'] > 0, df['A'] < -1]
choices = ['high', 'medium', 'low']
df['E'] = np.select(conditions, choices, default='other')

# Map (for Series)
mapping = {'positive': 1, 'negative': -1}
df['F'] = df['D'].map(mapping)

print("\\nBest practices:")
print("1. Use vectorized operations when possible")
print("2. Use np.where for simple conditionals")
print("3. Use np.select for multiple conditions")
print("4. Use map for Series transformations")
print("5. Use apply only as last resort")"""),
])

