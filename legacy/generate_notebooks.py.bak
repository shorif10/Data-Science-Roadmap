    ("Advanced Statistical Visualization", """Complex statistical plots.""",
     "code", """import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Load datasets
tips = sns.load_dataset('tips')
titanic = sns.load_dataset('titanic')

# FacetGrid
g = sns.FacetGrid(tips, col='time', row='smoker', height=4)
g.map(sns.scatterplot, 'total_bill', 'tip')
g.add_legend()
plt.show()

# PairGrid
g = sns.PairGrid(tips, hue='sex', height=3)
g.map_diag(sns.histplot)
g.map_offdiag(sns.scatterplot)
g.add_legend()
plt.show()

# Regression plots
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

sns.residplot(data=tips, x='total_bill', y='tip', ax=axes[0])
axes[0].set_title('Residual Plot')

sns.lmplot(data=tips, x='total_bill', y='tip', col='smoker', row='time')
plt.show()

# Distribution plots
fig, axes = plt.subplots(1, 2, figsize=(14, 5))

sns.kdeplot(data=tips, x='total_bill', y='tip', cmap='Blues', fill=True, ax=axes[0])
axes[0].set_title('2D KDE')

sns.rugplot(data=tips, x='total_bill', y='tip', ax=axes[1])
axes[1].set_title('Rug Plot')

plt.tight_layout()
plt.show()"""),

    ("Dashboard-Quality Visualizations", """Create professional, presentation-ready charts.""",
     "code", """import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd
import numpy as np

# Set professional theme
sns.set_theme(style="whitegrid", palette="husl")

# Create dashboard
fig = plt.figure(figsize=(16, 10))
fig.suptitle('Sales Analytics Dashboard', fontsize=20, fontweight='bold', y=0.98)

# Data
np.random.seed(42)
months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun']
sales_a = [120, 150, 180, 160, 200, 220]
sales_b = [100, 130, 150, 170, 180, 190]
categories = ['Electronics', 'Clothing', 'Food', 'Books']
cat_values = [35, 25, 25, 15]

# Plot 1: Line chart (sales trend)
ax1 = fig.add_subplot(2, 3, 1)
ax1.plot(months, sales_a, marker='o', linewidth=2, label='Product A')
ax1.plot(months, sales_b, marker='s', linewidth=2, label='Product B')
ax1.set_title('Monthly Sales Trend')
ax1.legend()
ax1.grid(True, alpha=0.3)

# Plot 2: Bar chart (category comparison)
ax2 = fig.add_subplot(2, 3, 2)
bars = ax2.bar(categories, cat_values, color=sns.color_palette("husl", 4))
ax2.set_title('Sales by Category')
ax2.set_ylabel('Percentage')

# Plot 3: Pie chart (market share)
ax3 = fig.add_subplot(2, 3, 3)
ax3.pie(cat_values, labels=categories, autopct='%1.1f%%', colors=sns.color_palette("husl", 4))
ax3.set_title('Market Share')

# Plot 4: Heatmap (daily activity)
ax4 = fig.add_subplot(2, 3, 4)
data = np.random.rand(7, 24)
sns.heatmap(data, ax=ax4, cmap='YlOrRd', cbar_kws={'label': 'Activity Level'})
ax4.set_title('Weekly Activity Heatmap')
ax4.set_xlabel('Hour')
ax4.set_ylabel('Day')

# Plot 5: Box plot (distribution)
ax5 = fig.add_subplot(2, 3, 5)
df = pd.DataFrame({
    'Region': np.random.choice(['North', 'South', 'East', 'West'], 200),
    'Revenue': np.random.randn(200) * 1000 + 5000
})
sns.boxplot(data=df, x='Region', y='Revenue', ax=ax5)
ax5.set_title('Revenue Distribution by Region')

# Plot 6: KPI cards
ax6 = fig.add_subplot(2, 3, 6)
ax6.axis('off')
kpi_data = [
    ('Total Revenue', '$1.2M', '+15%'),
    ('Customers', '12,456', '+8%'),
    ('Orders', '8,234', '+12%')
]
for i, (label, value, change) in enumerate(kpi_data):
    y = 0.7 - i * 0.3
    ax6.text(0.1, y, label, fontsize=12, color='gray')
    ax6.text(0.1, y - 0.1, value, fontsize=18, fontweight='bold')
    ax6.text(0.7, y - 0.1, change, fontsize=14, color='green')
ax6.set_title('Key Metrics')

plt.tight_layout()
plt.savefig('dashboard.png', dpi=300, bbox_inches='tight')
plt.show()"""),
])

