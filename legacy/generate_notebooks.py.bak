nested = [[1, 2], [3, 4], [5, 6]]

# List from iterable
chars = list("Python")
print(chars)  # ['P', 'y', 't', 'h', 'o', 'n']

# List repetition
zeros = [0] * 5
print(zeros)  # [0, 0, 0, 0, 0]

# List properties
print(len(numbers))   # 5
print(max(numbers))   # 5
print(min(numbers))   # 1
print(sum(numbers))   # 15
print(numbers.count(3))  # 1
